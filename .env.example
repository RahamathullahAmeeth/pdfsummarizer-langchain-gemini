# Copy this file to .env and add your own key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used by the app. A known-working default is gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback if the primary model is unavailable / rate limited.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
